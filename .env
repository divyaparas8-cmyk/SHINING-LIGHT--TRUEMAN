# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Local MongoDB connection (agar local use kar rahe ho):
MONGO_URI=mongodb://127.0.0.1:27017/school-crm
# MongoDB Atlas (Cloud) connection example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shining_light_crm?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=shining_light_super_secret_jwt_key_2026_change_in_production

# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration (For Student Documents & File Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ImageKit Configuration (For Assessments & User Avatars)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Stripe Payment Gateway (For Subscription & Checkout Billing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
